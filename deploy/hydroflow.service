# /etc/systemd/system/hydroflow.service
#
#   sudo cp deploy/hydroflow.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hydroflow
#   sudo journalctl -u hydroflow -f

[Unit]
Description=Hydroflow Tanjung Manis — IoT Monitoring & EMS
Documentation=file:/opt/hydroflow/docs/DEVICE-INTEGRATION.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hydroflow
Group=hydroflow
WorkingDirectory=/opt/hydroflow
ExecStart=/usr/bin/node server/index.js
EnvironmentFile=/opt/hydroflow/.env
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hydroflow

# Bind :1883 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Hardening — the process only ever needs to write ./data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hydroflow/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
