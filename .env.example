# ── Hydroflow Tanjung Manis — IoT Monitoring & EMS ───────────────────────────
PORT=3000
MQTT_PORT=1883

# Historian
DB_FILE=./data/hydroflow.db
SCAN_INTERVAL_MS=3000          # live scan / WebSocket push rate
PERSIST_INTERVAL_MS=60000      # how often a scan is written to the historian
RETENTION_DAYS=30              # raw sample retention (hourly rollups are kept forever)
SEED_DAYS=14                   # synthetic history generated on an empty database

# Security — CHANGE BOTH BEFORE EXPOSING THE SERVER
JWT_SECRET=change-me-to-a-long-random-string
DEFAULT_PASSWORD=hydroflow2026
TOKEN_TTL=12h

# MQTT ingest credentials (leave blank to allow anonymous on the LAN only)
MQTT_USERNAME=
MQTT_PASSWORD=

# Set to "off" once every subsystem publishes real telemetry.
# Individual tags switch to live data automatically as soon as a device
# publishes them — you do not need to turn the simulator off subsystem by
# subsystem.
SIMULATOR=on
